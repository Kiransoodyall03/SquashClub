{
  "$comment": [
    "Composite indexes for every where + orderBy combination in the app.",
    "These previously existed only in the Firebase console. A missing index",
    "surfaced as an empty list rather than an error, because the data layer",
    "swallows exceptions - which meant silent data loss in the UI.",
    "Deploy with: firebase deploy --only firestore:indexes"
  ],
  "indexes": [
    {
      "$comment": "Booking grid: every booking on a court for a date range.",
      "collectionGroup": "bookings",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "date", "order": "ASCENDING" },
        { "fieldPath": "status", "order": "ASCENDING" },
        { "fieldPath": "startTime", "order": "ASCENDING" }
      ]
    },
    {
      "$comment": "A member's own upcoming and past bookings.",
      "collectionGroup": "bookings",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "playerIds", "arrayConfig": "CONTAINS" },
        { "fieldPath": "startAt", "order": "DESCENDING" }
      ]
    },
    {
      "$comment": "Utilisation analytics: bookings per court over a period.",
      "collectionGroup": "bookings",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "courtId", "order": "ASCENDING" },
        { "fieldPath": "date", "order": "ASCENDING" }
      ]
    },
    {
      "$comment": "No-show and cancellation reporting.",
      "collectionGroup": "bookings",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "status", "order": "ASCENDING" },
        { "fieldPath": "startAt", "order": "DESCENDING" }
      ]
    },
    {
      "collectionGroup": "waitlist",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "date", "order": "ASCENDING" },
        { "fieldPath": "startTime", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "ASCENDING" }
      ]
    },
    {
      "collectionGroup": "waitlist",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "memberId", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },
    {
      "collectionGroup": "courtClosures",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "toDate", "order": "ASCENDING" },
        { "fieldPath": "fromDate", "order": "ASCENDING" }
      ]
    },
    {
      "$comment": "A player's rating curve.",
      "collectionGroup": "ratingHistory",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "playerId", "order": "ASCENDING" },
        { "fieldPath": "at", "order": "ASCENDING" }
      ]
    },
    {
      "collectionGroup": "individualMatches",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "playerIds", "arrayConfig": "CONTAINS" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },
    {
      "$comment": "The pending-actions surface: what needs this member's response.",
      "collectionGroup": "individualMatches",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "playerIds", "arrayConfig": "CONTAINS" },
        { "fieldPath": "status", "order": "ASCENDING" },
        { "fieldPath": "updatedAt", "order": "DESCENDING" }
      ]
    },
    {
      "$comment": "Head-to-head lookups and completed-match analytics.",
      "collectionGroup": "individualMatches",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "status", "order": "ASCENDING" },
        { "fieldPath": "completedAt", "order": "DESCENDING" }
      ]
    },
    {
      "$comment": "Auto-confirmation sweep.",
      "collectionGroup": "individualMatches",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "status", "order": "ASCENDING" },
        { "fieldPath": "autoConfirmAt", "order": "ASCENDING" }
      ]
    },
    {
      "collectionGroup": "matches",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "tournamentId", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },
    {
      "collectionGroup": "matches",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "players", "arrayConfig": "CONTAINS" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },
    {
      "$comment": "Tournament schedule view: matches by court and time.",
      "collectionGroup": "matches",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "tournamentId", "order": "ASCENDING" },
        { "fieldPath": "scheduledStart", "order": "ASCENDING" }
      ]
    },
    {
      "collectionGroup": "tournaments",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "createdBy", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },
    {
      "collectionGroup": "tournaments",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "status", "order": "ASCENDING" },
        { "fieldPath": "date", "order": "DESCENDING" }
      ]
    },
    {
      "$comment": "Leaderboard. Previously fetched the whole users collection.",
      "collectionGroup": "users",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "role", "order": "ASCENDING" },
        { "fieldPath": "disabled", "order": "ASCENDING" },
        { "fieldPath": "elo", "order": "DESCENDING" }
      ]
    },
    {
      "collectionGroup": "notifications",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "recipientId", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },
    {
      "collectionGroup": "auditLog",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "entity", "order": "ASCENDING" },
        { "fieldPath": "at", "order": "DESCENDING" }
      ]
    }
  ],
  "fieldOverrides": []
}
